rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function auth() { return request.auth != null; }
    match /setores/{id} { allow read, write: if auth(); }
    match /funcionarios/{id} { allow read, write: if auth(); }
    match /comunicacoes_pessoal/{id} { allow read, write: if auth(); }
    match /configuracoes/{id} { allow read, write: if auth(); }
  }
}
